# Copy to .env or export in your shell before starting.
# Defaults are shown; only override what you need.

PBS_TARGET=2000
PBS_DB_PATH=database/prize_bonds.db
PBS_EXPORTS_DIR=exports
PBS_CAPTURES_DIR=database/captures

# OCR
PBS_OCR_LANG=ben+eng
PBS_OCR_PSM=7
PBS_AUTO_SAVE_CONFIDENCE=72
PBS_SINGLE_VARIANT_CONFIDENCE=94
PBS_FRAME_DEDUPE_SECONDS=2.5

# Serial format: current Bangladesh 100-taka bonds are 7 digits.
PBS_SERIAL_PATTERN=^[A-Z\u0985-\u09B9\u09DC-\u09DF]{0,2}\d{7}$
PBS_MIN_SERIAL_DIGITS=7
PBS_MAX_SERIAL_DIGITS=7

# Optional explicit paths
# PBS_TESSERACT_CMD=/usr/bin/tesseract
# PBS_TESSDATA_DIR=/usr/share/tesseract-ocr/5/tessdata

PBS_TIMEZONE=Asia/Dhaka
PBS_MAX_UPLOAD_MB=12
PBS_MAX_EXPORTS_KEPT=20
PBS_CORS_ORIGINS=*
PBS_SERVE_FRONTEND=true
